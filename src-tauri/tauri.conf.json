{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "CTTP Renforcement",
  "identifier": "com.rn120.cttp",
  "build": {
    "beforeBuildCommand": "bash scripts/tauri-export.sh",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CTTP Renforcement — Pavement Design",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "CTTP Direction des Études Techniques — Alger",
    "category": "Productivity",
    "shortDescription": "CTTP-compliant pavement reinforcement design tool",
    "longDescription": "Production-ready pavement reinforcement design application following the Algerian CTTP Guide des Renforcements (Dec 1992). Computes traffic classes, deflection corrections, and reinforcement structures with full traceability and AI-powered distress detection.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
